@model List<Pods.Application.DTOs.GroupSummaryDto>
@{
    ViewData["Title"] = "Accountability Groups";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Public Accountability Pods</h2>
        <p class="text-muted mb-0">Join an accountability circle and commit daily proof to preserve your streak.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Create New Pod</a>
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5">
            <h5 class="text-muted">No accountability groups found. Create the first one!</h5>
        </div>
    }
    @foreach (var pod in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">@pod.Category</span>
                        <small class="text-muted">@pod.ActiveMembersCount / @pod.MaxMembers members</small>
                    </div>
                    <h5 class="card-title fw-bold text-dark">@pod.Name</h5>
                    <p class="card-text text-secondary small">@pod.Description</p>
                </div>
                <div class="card-footer bg-white border-0 pt-0">
                    <a asp-action="Details" asp-route-id="@pod.Id" class="btn btn-outline-primary w-100">Enter Pod</a>
                </div>
            </div>
        </div>
    }
</div>
